{
  "id": null,
  "uid": "techstyle-host",
  "title": "TechStyle – EC2 Systemmetriken",
  "tags": ["techstyle", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [{"name": "prometheus", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1}]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU-Auslastung",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${prometheus}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"techstyle-node\",mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 2,
      "title": "Arbeitsspeicher belegt",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${prometheus}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"techstyle-node\"} / node_memory_MemTotal_bytes{job=\"techstyle-node\"})", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 3,
      "title": "Root-Dateisystem belegt",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${prometheus}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"techstyle-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"techstyle-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 4,
      "title": "Exporter erreichbar (1 = UP)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${prometheus}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "up{job=\"techstyle-node\"}", "legendFormat": "{{instance}}"}]
    }
  ]
}
